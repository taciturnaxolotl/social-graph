{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "social-graph",
  "account_id": "fdbe5b542ede643d34962c1f07a34565",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every path the worker owns. Everything else is a static asset, and a
    // navigation that matches neither falls through to the SPA shell.
    "run_worker_first": ["/api/*", "/auth/*", "/photos/*", "/i/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "social-graph",
      "database_id": "83f1f1ef-f5a8-41de-b401-3362ad6029e7",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "social-graph-photos" }],
  "vars": {
    // Where the deployed app lives. This decides the OAuth redirect and
    // whether session cookies are marked Secure, so it is not decoration.
    "ORIGIN": "https://social-graph.kieran-fdb.workers.dev",
    "ALLOWED_DOMAIN": "cedarville.edu",
    "ADMIN_EMAILS": "kieranklukas@cedarville.edu"
  },
  // One public surface, not one per version: this app holds ten thousand real
  // names and every extra URL is another door to remember to lock.
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true }
}
