{
  "name": "social-graph",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply social-graph --local",
    "db:remote": "wrangler d1 migrations apply social-graph --remote",
    "seed": "bun run scripts/seed.ts",
    "photos": "bun run scripts/photos.ts",
    "export": "bun run scripts/export.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check --write",
    "ci": "biome ci . && bun run typecheck && bun test",
    "types": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@cloudflare/vite-plugin": "^1.13.0",
    "@cloudflare/workers-types": "^5.20260903.1",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.5.0",
    "vite": "^7.1.0",
    "wrangler": "^4.42.0"
  }
}
